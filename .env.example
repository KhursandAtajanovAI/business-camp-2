# Copy to .env.local (ignored by git) and fill in locally. Never commit real values.
# The site works without any of these: payments fall back to a clearly marked test
# checkout and explanations fall back to templates.

# Stripe TEST secret key (must start with sk_test_). Live keys are refused by the code.
STRIPE_SECRET_KEY=

# Key for the language model that polishes explanations. Optional.
ANTHROPIC_API_KEY=

# Public address of the site, used for payment return links.
NEXT_PUBLIC_SITE_URL=
